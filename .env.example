# Forge server settings. Set these in Vercel → Project → Settings → Environment Variables
# (never commit real values). Only APP_PASSCODE is needed for reminders; the rest are optional.

# Access code your phone sends to use reminders and the AI coach. Pick something long.
APP_PASSCODE=

# Added automatically when you connect a private Blob store to the project (Storage tab).
BLOB_READ_WRITE_TOKEN=

# Optional — enables the AI coach and photo/text meal logging (console.anthropic.com → API keys).
ANTHROPIC_API_KEY=
# Optional — pin a specific Claude model id; by default the newest Claude Opus model is used.
AI_MODEL=

# Optional — lets an outside scheduler (e.g. cron-job.org) call /api/tick with
# "Authorization: Bearer <CRON_SECRET>" for minute-exact reminders.
CRON_SECRET=

# Optional — fixed web-push keys. If unset, a key pair is generated once and kept in Blob storage.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional — only if the GitHub repository is replaced by a different one (its numeric id).
GITHUB_REPOSITORY_ID=
